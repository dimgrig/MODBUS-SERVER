# syntax=docker/dockerfile:1
ARG BASE_DEPS_IMAGE=base-deps-win64-qt6:latest
ARG INNOSETUP_IMAGE=ghcr.io/dimgrig/innosetup-base:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG CORE_SDK_VERSION=1.1.0
ARG CORE_SDK_URL=
ARG CORE_SDK_PLATFORM=win64
ARG CORE_SDK_SHA256=
ARG QT_VERSION_MAJOR=6
ARG QT6_INSTALL_PREFIX=/opt/Qt/6.8.0/mingw_64
ARG QT_HOST_PATH=/opt/Qt/6.8.0/gcc_64
ARG CMAKE_TOOLCHAIN_FILE=/opt/x86_64-w64-mingw32.cmake
ARG CORE_INSTALL_BASE=/opt/modbus-server
ARG BUILD_TYPE=Release

ENV CORE_SDK_PLATFORM=${CORE_SDK_PLATFORM} LANG=C.UTF-8 LC_ALL=C.UTF-8

COPY .ci/scripts/fetch-core-sdk.sh /opt/ci/fetch-core-sdk.sh
COPY .ci/scripts/build-app.sh       /opt/ci/build-app.sh
RUN chmod +x /opt/ci/*.sh && \
    echo "core-sdk: v${CORE_SDK_VERSION} sha=${CORE_SDK_SHA256}" && \
    /opt/ci/fetch-core-sdk.sh "${CORE_SDK_VERSION}" "${CORE_SDK_URL}" \
        "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
        "${QT_VERSION_MAJOR}" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
            "/opt/core/qt${QT_VERSION_MAJOR}/latest" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/latest" "/opt/core/latest"

WORKDIR /app
COPY . /app/modbus-server/
WORKDIR /app/modbus-server

ENV APP_NAME=modbus-server
RUN /opt/ci/build-app.sh

FROM build AS deploy
SHELL ["/bin/bash", "-c"]
ARG QT_VERSION_MAJOR
ARG QT6_INSTALL_PREFIX
ARG CORE_INSTALL_BASE
ARG MINGW_TRIPLET=x86_64-w64-mingw32
ARG MINGW_PEI=pei-x86-64
ARG MINGW_GCC_SUFFIX=seh-1

COPY .ci/scripts/deploy-windows.sh /opt/ci/deploy-windows.sh
RUN chmod +x /opt/ci/deploy-windows.sh && \
    V="$(tr -d '[:space:]' < VERSION)" && \
    LOCAL_INSTALL="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}" \
    APP_NAME_BIN="${APP_NAME}" \
    DIST_NAME=ModbusServerDistributionKit \
    DEPLOY_DIR=/deploy \
    QT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
    QT6_INSTALL_PREFIX="${QT6_INSTALL_PREFIX}" \
    MINGW_TRIPLET="${MINGW_TRIPLET}" \
    MINGW_PEI="${MINGW_PEI}" \
    MINGW_GCC_SUFFIX="${MINGW_GCC_SUFFIX}" \
    CORE_LIBS="libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib" \
    ICON_SRC=/app/modbus-server/resources/modbus.ico \
    CONFIG_INI=/app/modbus-server/deploy/config.ini \
    /opt/ci/deploy-windows.sh


FROM ${INNOSETUP_IMAGE} AS innosetup
COPY --from=deploy /deploy /app/modbus-server/deploy
COPY setup /app/modbus-server/setup
COPY resources/modbus.ico /app/modbus-server/setup/modbus.ico
COPY VERSION /app/modbus-server/VERSION
COPY .ci/scripts/make-innosetup.sh /opt/ci/make-innosetup.sh
WORKDIR /app/modbus-server
RUN chmod +x /opt/ci/make-innosetup.sh && \
    DEPLOY_DIR=/app/modbus-server/deploy \
    SETUP_DIR=/app/modbus-server/setup \
    /opt/ci/make-innosetup.sh

FROM alpine:latest AS packager
COPY --from=innosetup /app/modbus-server/setup/*.exe /staging/

# Для GitHub CI (только установщик Inno Setup)
FROM scratch AS export
COPY --from=packager /staging/*.exe /

# Для локальной сборки (EXPORT_MODE=dev: установщик + папка дистрибутива)
FROM scratch AS export-dev
COPY --from=packager /staging/*.exe /
COPY --from=deploy /deploy/ModbusServerDistributionKit /ModbusServerDistributionKit

FROM build AS final