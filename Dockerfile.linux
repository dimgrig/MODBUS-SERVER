# syntax=docker/dockerfile:1
ARG BASE_DEPS_IMAGE=base-deps-linux-qt6:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG CORE_SDK_VERSION=1.1.0
ARG CORE_SDK_URL=
ARG CORE_SDK_SHA256=
ARG QT_VERSION_MAJOR=6
ARG QT6_INSTALL_PREFIX=/opt/Qt/6.8.0/gcc_64
ARG CORE_INSTALL_BASE=/opt/modbus-server
ARG CMAKE_TOOLCHAIN_FILE=
ARG BUILD_TYPE=Release

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 QT_QPA_PLATFORM=offscreen

COPY .ci/scripts/fetch-core-sdk.sh /opt/ci/fetch-core-sdk.sh
COPY .ci/scripts/build-app.sh       /opt/ci/build-app.sh
RUN chmod +x /opt/ci/*.sh && \
    echo "core-sdk: v${CORE_SDK_VERSION} sha=${CORE_SDK_SHA256}" && \
    /opt/ci/fetch-core-sdk.sh "${CORE_SDK_VERSION}" "${CORE_SDK_URL}" \
        "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
        "${QT_VERSION_MAJOR}" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
            "/opt/core/qt${QT_VERSION_MAJOR}/latest" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/latest" "/opt/core/latest"

WORKDIR /app
COPY . /app/modbus-server/
WORKDIR /app/modbus-server

ENV APP_NAME=modbus-server
ENV CORE_LIBS="libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib"
RUN /opt/ci/build-app.sh

FROM build AS deploy
ARG QT_VERSION_MAJOR
ARG QT6_INSTALL_PREFIX
ARG CORE_INSTALL_BASE

COPY .ci/scripts/deploy-linux.sh /opt/ci/deploy-linux.sh
RUN chmod +x /opt/ci/deploy-linux.sh && \
    V="$(tr -d '[:space:]' < VERSION)" && \
    LOCAL_INSTALL="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}" \
    APP_NAME_BIN="${APP_NAME}" \
    DIST_NAME=ModbusServerDistributionKit \
    DEPLOY_DIR=/deploy \
    QT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
    QT6_INSTALL_PREFIX="${QT6_INSTALL_PREFIX}" \
    ARCH_TRIPLET=x86_64-linux-gnu \
    CORE_LIBS="libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib" \
    /opt/ci/deploy-linux.sh

FROM deploy AS test
ENV QT_QPA_PLATFORM=offscreen
RUN . /deploy/appinfo.env && \
    LD_LIBRARY_PATH="/deploy/${DIST_KIT_NAME}/lib" MODBUS_SMOKE=1 \
        "/deploy/${DIST_KIT_NAME}/bin/${APP_NAME_BIN}" && \
    echo "=== test OK ==="

FROM debian:bookworm-slim AS packager
ARG QT_VERSION_MAJOR=6
RUN apt-get update && \
    apt-get install -y --no-install-recommends imagemagick && \
    rm -rf /var/lib/apt/lists/*
COPY --from=deploy /deploy /deploy
COPY --from=build  /app/modbus-server/resources/modbus.ico /icon.ico
COPY .ci/scripts/make-deb.sh /opt/ci/make-deb.sh
RUN chmod +x /opt/ci/make-deb.sh && \
    DIST_NAME=ModbusServerDistributionKit \
    DEB_ARCH=amd64 \
    DEPLOY_DIR=/deploy \
    QT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
    ICON_SRC=/icon.ico \
    /opt/ci/make-deb.sh

# Для GitHub CI (только .deb)
FROM scratch AS export
COPY --from=packager /deploy/*.deb /

# Для локальной сборки (EXPORT_MODE=dev: .deb + папка дистрибутива)
FROM scratch AS export-dev
COPY --from=packager /deploy/*.deb /
COPY --from=deploy /deploy/ModbusServerDistributionKit /ModbusServerDistributionKit

FROM build AS final